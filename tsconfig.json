
{
  "compilerOptions": {
    "target": "ES2022",
   "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server.ts",
    "models/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
